---
const today = new Date();
const base = import.meta.env.BASE_URL;
---

<footer>
	&copy; {today.getFullYear()} Garanty Studios. All rights reserved.
	<div class="social-links">
		<a href="https://youtube.com/@garantystudios" target="_blank">
			<img src="/icons/yt.svg" alt="YouTube" width="32" height="32" />
		</a>
		<a href="https://x.com/GarantyStudios" target="_blank">
			<span class="sr-only">Follow Garanty Studios on Twitter</span>
			<img src="/icons/x.svg" alt="X (formerly Twitter)" width="32" height="32" />
		</a>
		<a href="https://discord.gg/yHtWspSXDc" target="_blank">
			<span class="sr-only">Join our Discord server</span>
			<img src="/icons/dc.svg" alt="Discord" width="32" height="32" />
		</a>
	</div>
</footer>
<style>
	footer {
		width: 100%;
		margin: 0;
		padding: 1.25em 1em 1.5em;
		border-top: 1px solid rgb(var(--gray-light));
		background: #ededed;
		color: var(--text);
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		color: inherit;
		text-decoration: none;
		transition: transform var(--motion-fast) var(--motion-ease);
	}
	.social-links a:hover {
		color: var(--accent);
		transform: scale(1.15);
	}
</style>
