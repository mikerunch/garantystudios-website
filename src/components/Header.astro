---
import HeaderLink from "./HeaderLink.astro";
---

<header class="navbar">
  <div class="navbar-inner">
    <div class="left">
      <a class="logo" href="/">
        <img src="/images/logo.png" alt="Logo" />
      </a>
    </div>

    <nav class="center" aria-label="Main navigation">
      <HeaderLink href="/games">Games</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <HeaderLink href="/contact">Contact</HeaderLink>
      <HeaderLink href="/docs">Docs</HeaderLink>

    </nav>

    <div class="right" aria-label="Social links">
      <a href="https://youtube.com/@garantystudios" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
        <img src="/icons/yt.svg" alt="" class="sm_icon" />
      </a>
      <a href="https://x.com/garantystudios" target="_blank" rel="noopener noreferrer" aria-label="X">
        <img src="/icons/x.svg" alt="" class="sm_icon" />
      </a>
      <a href="https://discord.gg/yHtWspSXDc" target="_blank" rel="noopener noreferrer" aria-label="Discord">
        <img src="/icons/dc.svg" alt="" class="sm_icon"/>
      </a>
    </div>
  </div>
</header>

<style>
.navbar {
  width: 100%;
  position: sticky;
  z-index: 1000;
  top: 0;
  border-bottom: 1px solid #dfe3eb;
  background: #fdfdfd;
}

.navbar-inner {
  display: flex;
  width: min(100% - 3rem, 1120px);
  min-height: 4.5rem;
  margin: 0 auto;
  justify-content: space-between;
  align-items: center;
  gap: 2rem;
}

.left {
  display: flex;
  align-items: center;
}

.center {
  display: flex;
  gap: clamp(1rem, 3vw, 2.5rem);
  justify-content: center;
  align-items: center;
  flex: 1 1 auto;
  min-width: 0;
}

.right {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

:global(.center a) {
  padding: 0.4rem 0;
  color: inherit;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  text-underline-offset: 0.3em;
  transition: color var(--motion-fast) var(--motion-ease);
}

:global(.center a:hover),
:global(.center a.active) {
  color: var(--accent);
}

.logo img {
  display: block;
  width: auto;
  max-height: 2.75rem;
  aspect-ratio: 16 / 9;
  object-fit: contain;
}

.right a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.4rem;
  border-radius: 0.35rem;
  transition: opacity var(--motion-fast) var(--motion-ease);
  transition: transform var(--motion-fast) var(--motion-ease);
}

.right a:hover {
  opacity: 1;
  transform: scale(1.15);
}

.right a:hover .sm_icon {
  fill: black;
}

.right img {
  display: block;
  width: 1.75rem;
  height: 1.75rem;
  object-fit: contain;
}

@media (max-width: 600px) {
  .navbar-inner {
    width: calc(100% - 2rem);
    min-height: 4rem;
    gap: 1rem;
  }

  .center {
    gap: 1rem;
  }

  .right {
    gap: 0.15rem;
  }

  .right img {
    width: 1.25rem;
    height: 1.25rem;
  }
}

@media (max-width: 420px) {
  .navbar-inner {
    width: calc(100% - 1.25rem);
    gap: 0.5rem;
  }

  .logo img {
    max-width: 4rem;
  }

  .center {
    gap: 0.65rem;
  }

  :global(.center a) {
    font-size: 0.85rem;
  }
}
</style>