---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Contact`} description="Contact Garanty Studios for support, questions, and other inquiries." />
    <script
      is:inline
      src="https://static.zohocdn.com/zohodeskstatic/app/js/jqueryandencoder.ef05974972bf3bca1b87.js"
    ></script>
    <script is:inline>
      function zsShowCaptcha() {
        jQuery('#zsCaptchaLoading').hide();
        jQuery('#zsCaptcha').show();
      }

      function zsRegenerateCaptcha() {
        const request = new XMLHttpRequest();
        request.open(
          'GET',
          'https://desk.zoho.eu/support/GenerateCaptcha?action=getNewCaptcha&_=' + Date.now(),
          true,
        );
        request.onreadystatechange = function () {
          if (request.readyState !== 4) return;

          if (request.status !== 200) {
            const error = document.getElementById('captcha-error');
            if (error) {
              error.textContent = 'Could not load the captcha. Please try refreshing it.';
              error.hidden = false;
            }
            return;
          }

          try {
            const response = JSON.parse(request.responseText);
            if (typeof response.captchaUrl !== 'string' || typeof response.captchaDigest !== 'string') {
              throw new Error('Captcha response was invalid.');
            }

            const image = document.getElementById('zsCaptchaUrl');
            const digest = document.getElementsByName('xJdfEaS')[0];
            const error = document.getElementById('captcha-error');
            if (!(image instanceof HTMLImageElement) || !(digest instanceof HTMLInputElement)) {
              throw new Error('Captcha form fields were not found.');
            }

            jQuery('#zsCaptchaUrl').load(zsShowCaptcha);
            image.src = response.captchaUrl;
            digest.value = response.captchaDigest;
            if (error) error.hidden = true;
          } catch (error) {
            const message = document.getElementById('captcha-error');
            if (message) {
              message.textContent = 'Could not load the captcha. Please try refreshing it.';
              message.hidden = false;
            }
            console.error('Unable to load contact form captcha.', error);
          }
        };
        request.onerror = function () {
          const error = document.getElementById('captcha-error');
          if (error) {
            error.textContent = 'Could not load the captcha. Please try refreshing it.';
            error.hidden = false;
          }
        };
        request.send();
      }

      document.addEventListener('readystatechange', function () {
        if (document.readyState === 'complete') zsRegenerateCaptcha();
      });
    </script>
  </head>
  <body>
    <Header />
    <main class="contact-page">
      <h1>Contact us</h1>
      <p><b>Anything</b> you wanna tell us? We'd love to hear from you. Hit us up!</p>

      <form
        id="zsWebToCase_244967000000389006"
        action="https://desk.zoho.eu/support/WebToCase"
        method="POST"
        enctype="multipart/form-data"
      >
        <input type="hidden" name="xnQsjsdp" value="edbsn0164a7d51ffd91a8709e9c1411f55043" />
        <input type="hidden" name="xmIwtLD" value="edbsndff86597597e19c5c8f3adad6ec8e4bb28fefb6d1457057219c9fc225187e4f6" />
        <input type="hidden" name="xJdfEaS" value="" />
        <input type="hidden" name="actionType" value="Q2FzZXM=" />
        <input type="hidden" id="property(module)" value="Cases" />
        <input
          type="hidden"
          id="dependent_field_values_Cases"
          value='{"JSON_VALUES":{},"JSON_SELECT_VALUES":{},"JSON_MAP_DEP_LABELS":[]}'
        />
        <input type="hidden" name="returnURL" value="https://garantystudios.net/contact/success" />

        <div class="form-field">
          <label for="contact-name">Name <span aria-hidden="true">*</span></label>
          <input
            id="contact-name"
            type="text"
            name="Contact Name"
            maxlength="120"
            autocomplete="name"
            required
          />
          <small>A name we can call you. It doesn’t have to be your real name.</small>
        </div>

        <div class="form-field">
          <label for="contact-email">Email <span aria-hidden="true">*</span></label>
          <input
            id="contact-email"
            type="email"
            name="Email"
            maxlength="120"
            autocomplete="email"
            required
          />
          <small>Your email address so we can write you back.</small>
        </div>

        <div class="form-field">
          <label for="contact-subject">Subject <span aria-hidden="true">*</span></label>
          <input id="contact-subject" type="text" name="Subject" maxlength="255" required />
          <small>Describe your subject shortly.</small>
        </div>

        <div class="form-field">
          <label for="contact-message">Message <span aria-hidden="true">*</span></label>
          <textarea id="contact-message" name="Description" maxlength="3000" rows="7" required></textarea>
          <small>Write down what you want to tell us.</small>
        </div>

        <div class="form-field captcha-field">
          <label for="captcha-answer">Captcha <span aria-hidden="true">*</span></label>
          <div class="captcha-challenge">
            <div id="zsCaptchaLoading" role="status"><strong>Loading captcha…</strong></div>
            <div id="zsCaptcha" class="captcha-image" style="display: none;">
              <img id="zsCaptchaUrl" name="zsCaptchaImage" alt="Captcha challenge" />
              <button id="captcha-refresh" class="button button--secondary" type="button" onclick="zsRegenerateCaptcha()">Refresh</button>
            </div>
          </div>
          <input
            id="captcha-answer"
            type="text"
            name="zsWebFormCaptchaWord"
            autocomplete="off"
            required
          />
          <input type="hidden" name="zsCaptchaSrc" value="" />
          <p id="captcha-error" class="form-error" role="alert" hidden></p>
        </div>

        <div class="form-actions">
          <button id="zsSubmitButton_244967000000389006" class="button button--primary" type="submit">Send message</button>
          <button class="button button--secondary" type="reset">Reset</button>
        </div>
        <p class="powered-by">Powered by <a href="https://zoho.eu/desk" target="_blank" rel="noopener noreferrer">Zoho Desk</a></p>
      </form>
    </main>
    <Footer />

    <script>
      const form = document.querySelector<HTMLFormElement>('#zsWebToCase_244967000000389006');
      const submitButton = document.querySelector<HTMLButtonElement>('#zsSubmitButton_244967000000389006');
      const captchaError = document.querySelector<HTMLElement>('#captcha-error');
      const captchaRefresh = document.querySelector<HTMLButtonElement>('#captcha-refresh');
      const captchaAnswer = document.querySelector<HTMLInputElement>('#captcha-answer');

      if (!form || !submitButton || !captchaError || !captchaRefresh || !captchaAnswer) {
        throw new Error('Could not initialize the contact form.');
      }

      window.addEventListener('pageshow', () => {
        submitButton.disabled = false;
        if (captchaAnswer.value) {
          captchaAnswer.value = '';
          captchaAnswer.focus();
          captchaRefresh.click();
        }
      });

      form.addEventListener('submit', (event) => {
        if (!form.reportValidity()) {
          event.preventDefault();
          return;
        }

        submitButton.disabled = true;
      });

      form.addEventListener('reset', () => {
        submitButton.disabled = false;
        window.setTimeout(() => {
          captchaRefresh.click();
        });
      });
    </script>
  </body>
</html>

<style>
  .contact-page {
    width: min(100% - 2rem, 680px);
    max-width: none;
    padding: 3rem 0;
  }

  .contact-page h1 {
    margin-bottom: 0.5rem;
  }

  .contact-page > p {
    margin: 0 0 2.5rem;
  }

  #zsWebToCase_244967000000389006 {
    display: grid;
    gap: 2rem;
  }

  .form-field {
    display: grid;
    gap: 0.4rem;
  }

  .form-field label {
    font-size: 1rem;
    font-weight: 600;
  }

  .form-field label span {
    color: #c62828;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid #aeb6c2;
    border-radius: 0.35rem;
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 1rem;
  }

  .form-field textarea {
    resize: vertical;
  }

  .form-field input:focus-visible,
  .form-field textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .form-field small {
    color: rgb(var(--gray-dark));
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .captcha-challenge {
    display: flex;
    min-height: 3rem;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .captcha-image {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .captcha-challenge img {
    width: auto;
    max-width: min(100%, 280px);
    min-height: 2rem;
    border-radius: 0;
  }

  .captcha-challenge .button {
    min-height: 2.25rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
  }

  .form-error {
    margin: 0;
    color: #b42318;
    font-size: 0.9rem;
  }

  .powered-by {
    margin: 0;
    color: rgb(var(--gray));
    font-size: 0.8rem;
  }

  @media (max-width: 480px) {
    .contact-page {
      padding: 2rem 0;
    }

  }
</style>
