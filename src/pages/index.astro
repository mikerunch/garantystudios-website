---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="home-page">
    <Header />
    <canvas class="drawing-canvas" aria-hidden="true"></canvas>
    <main class="home">
      <section class="hero">
        <img src={`${base}images/vertical_logo.png`} alt="Garanty Studios" class="hero-logo" />
        <p class="hero-tagline">Let's have some fun together!</p>

        <div class="icon-row" aria-label="Find us online">
          <a class="button button--icon" href="https://store.steampowered.com/curator/46252144-Garanty-Studios/" target="_blank" rel="noopener noreferrer" aria-label="Steam" title="Steam">
            <img src="/icons/steam.svg" alt="" width="20" height="20" />
          </a>

          <a class="button button--icon" href="https://garantystudios.itch.io/" target="_blank" rel="noopener noreferrer" aria-label="Itch.io" title="Itch.io">
            <img src="/icons/itch.svg" alt="" width="20" height="20" />
          </a>
        </div>
      </section>
    </main>
		<Footer />
    <script>
      const canvas = document.querySelector('.drawing-canvas');

      if (!(canvas instanceof HTMLCanvasElement)) {
        throw new Error('Homepage drawing canvas was not found.');
      }

      const context = canvas.getContext('2d');

      if (!context) {
        throw new Error('Could not initialize the homepage drawing canvas.');
      }

      type Point = { x: number; y: number };
      const strokes: Point[][] = [];
      let activeStroke: Point[] | null = null;
      let drawingPointerId: number | null = null;

      function isPageElement(target: EventTarget | null): boolean {
        return target instanceof Element && Boolean(
          target.closest('header, footer, .hero, a, button, input, textarea, select, [contenteditable="true"]'),
        );
      }

      function resizeCanvas() {
        const pixelRatio = window.devicePixelRatio || 1;
        canvas.width = Math.round(window.innerWidth * pixelRatio);
        canvas.height = Math.round(window.innerHeight * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        redraw();
      }

      function redraw() {
        context.clearRect(0, 0, window.innerWidth, window.innerHeight);
        context.strokeStyle = 'rgba(0, 89, 255, 0.8)';
        context.fillStyle = 'rgba(0, 89, 255, 0.8)';
        context.lineWidth = 2.5;
        context.lineCap = 'round';
        context.lineJoin = 'round';

        for (const stroke of strokes) {
          const first = stroke[0];
          if (!first) continue;

          context.beginPath();
          context.moveTo(first.x - window.scrollX, first.y - window.scrollY);

          for (const point of stroke.slice(1)) {
            context.lineTo(point.x - window.scrollX, point.y - window.scrollY);
          }

          if (stroke.length === 1) {
            context.arc(first.x - window.scrollX, first.y - window.scrollY, 1.25, 0, Math.PI * 2);
            context.fill();
          } else {
            context.stroke();
          }
        }
      }

      document.addEventListener('pointerdown', (event) => {
        if (drawingPointerId !== null || event.button !== 0 || isPageElement(event.target)) {
          return;
        }

        event.preventDefault();
        drawingPointerId = event.pointerId;
        activeStroke = [{ x: event.pageX, y: event.pageY }];
        strokes.push(activeStroke);
        redraw();
      });

      document.addEventListener('pointermove', (event) => {
        if (event.pointerId !== drawingPointerId) return;

        if (isPageElement(event.target)) {
          activeStroke = null;
          return;
        }

        if (!activeStroke) {
          activeStroke = [];
          strokes.push(activeStroke);
        }

        activeStroke.push({ x: event.pageX, y: event.pageY });
        redraw();
      });

      document.addEventListener('pointerup', (event) => {
        if (event.pointerId !== drawingPointerId) return;

        drawingPointerId = null;
        activeStroke = null;
      });

      document.addEventListener('pointercancel', (event) => {
        if (event.pointerId !== drawingPointerId) return;

        drawingPointerId = null;
        activeStroke = null;
      });

      window.addEventListener('resize', resizeCanvas);
      window.addEventListener('scroll', redraw, { passive: true });
      resizeCanvas();
    </script>
	</body>
</html>
