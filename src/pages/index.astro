---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script is:inline>
      window.copyEmail = function (email, el) {
        navigator.clipboard.writeText(email);
        const original = el.innerText;
        el.innerText = 'Copied ✓';
        el.classList.add('copied');
        setTimeout(() => {
          el.innerText = original;
          el.classList.remove('copied');
        }, 1500);
      };

      window.openLink = function (url) {
        window.open(url, '_blank', 'noopener,noreferrer');
      };
    </script>
  </head>
  <body>
    <Header />
    <main class="home">
  <section class="hero">
    <img src={`${base}images/vertical_logo.png`} alt="Logo" class="hero-logo" />

    <div class="icon-row">
      <button class="icon-btn" aria-label="Steam" title="Steam" onclick="window.openLink('https://store.steampowered.com/')">
        <img src="/icons/steam.svg" alt="Steam" width="20" height="20" />
      </button>

      <button class="icon-btn" aria-label="Itch.io" title="Itch.io" onclick="window.openLink('https://itch.io/')">
        <img src="/icons/itch.svg" alt="Itch.io" width="20" height="20" />
      </button>
    </div>

    <!--<p>Support Myk, the developer!</p>-->
    <a href="https://linktr.ee/myk_gs" class="hero-button">Follow Myk</a>
  </section>

  <section class="contact">
    <button class="copy-btn" onclick="window.copyEmail('support@garantystudios.net', this)">support@garantystudios.net</button>
    <button class="copy-btn" onclick="window.copyEmail('promotion@garantystudios.net', this)">promotion@garantystudios.net</button>
  </section>
</main>

<style>
html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  overflow-x: hidden;
}

*, *::before, *::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #ffffff;
}

.home {
  width: 100%;
  box-sizing: border-box;
  color: #111;
  padding: 4rem 1.5rem;
  max-width: 700px;
  margin: 0 auto;
  text-align: center;
}

.home {
  position: relative;
  z-index: 1;
}

body::before {
  content: '';
  position: fixed;
  inset: 0;
  background-image: linear-gradient(to right, rgba(0,0,0,0.05) 1px, transparent 1px),
                    linear-gradient(to bottom, rgba(0,0,0,0.05) 1px, transparent 1px);
  background-size: 40px 40px;
  z-index: -1;
  pointer-events: none;
  animation: gridMove 20s linear infinite;
}

.hero {
  margin-top: 20vh;
  padding: 0 1rem;
}

.hero-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 1.5rem;
  padding: 0.6rem 1.2rem;
  border-radius: 999px;
  background: #0059ff;
  color: #fff;
  text-decoration: none;
  font-weight: 600;
  font-size: 0.9rem;
  transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
}

.hero-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  background: #222;
}

.icon-row {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  margin-top: 1.5rem;
  flex-wrap: wrap;
}

.icon-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 3.1rem;
  height: 3.1rem;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.12);
  background: #f5f7ff;
  cursor: pointer;
  transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
}

.icon-btn:hover {
  transform: translateY(-2px);
  background: #0059ff;
  border-color: #0059ff;
  box-shadow: 0 18px 30px rgba(0, 0, 0, 0.12);
}

.icon-btn:hover img {
  filter: brightness(0) invert(1);
}

.title {
  font-size: 3rem;
  font-weight: 700;
  margin-bottom: 1rem;
  animation: fadeUp 1s ease forwards, fontShift 6s infinite alternate ease-in-out;
}

.tagline {
  opacity: 0;
  font-size: 1.2rem;
  animation: fadeUp 1s ease forwards;
  animation-delay: 0.4s;
}

.contact {
  margin-top: 6rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  align-items: center;
}

.copy-btn {
  padding: 0.7rem 1.4rem;
  border-radius: 999px;
  border: 1px solid #111;
  background: transparent;
  cursor: pointer;
  transition: all 0.25s ease;
}

.copy-btn:hover {
  background: #111;
  color: #fff;
  transform: translateY(-2px);
}

.copy-btn.copied {
  background: #111;
  color: #fff;
  transform: scale(1.05);
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fontShift {
  0% {
    letter-spacing: 0px;
    transform: scale(1);
  }
  50% {
    letter-spacing: 2px;
    transform: scale(1.03);
  }
  100% {
    letter-spacing: 0px;
    transform: scale(1);
  }
}

@keyframes gridMove {
  from {
    background-position: 0 0, 0 0;
  }
  to {
    background-position: 40px 40px, 40px 40px;
  }
}

@media (max-width: 768px) {
  .hero {
    margin-top: 10vh;
  }

  .title {
    font-size: 2.2rem;
  }

  .tagline {
    font-size: 1rem;
  }

  .home {
    padding: 3rem 1rem;
  }
}

@media (max-width: 480px) {
  .hero {
    margin-top: 6vh;
  }

  .title {
    font-size: 1.8rem;
  }

  .contact {
    margin-top: 3rem;
  }

  .copy-btn {
    width: 100%;
    max-width: 320px;
  }
}
</style>
		<Footer />
	</body>
</html>
